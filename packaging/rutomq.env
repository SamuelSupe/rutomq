# Configure these values before enabling the service.
DATABASE_URL=postgres://rutomq:change-me@127.0.0.1:5432/rutomq
OBJECT_STORE_BACKEND=s3
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=rutomq
S3_ROOT=rutomq
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me

KAFKA_LISTEN_ADDR=0.0.0.0:9092
KAFKA_ADVERTISE_HOST=127.0.0.1
